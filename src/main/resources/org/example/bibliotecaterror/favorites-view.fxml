<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="940.0"
            styleClass="app-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bibliotecaterror.controller.FavoritesController">

   <!-- TOP HEADER -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <VBox spacing="4.0">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Label styleClass="brand-badge" text="PERSONAL COLLECTION" />
               <Label fx:id="labelFavCount" styleClass="stat-badge-accent" text="★ 0 Saved" />
            </HBox>
            <Label styleClass="header-title" text="Favorite Books Collection" />
            <Label styleClass="header-subtitle" text="Your curated shortlist of Stephen King works, persisted locally to favorites.json." />
         </VBox>
         <Region HBox.hgrow="ALWAYS" />
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="buttonLibrary" mnemonicParsing="false" styleClass="btn-secondary" text="← Back to Library" />
            <Button fx:id="buttonSaveFavorites" mnemonicParsing="false" styleClass="btn-primary" text="💾 Save Changes" />
         </HBox>
      </HBox>
   </top>

   <!-- CENTER TABLE -->
   <center>
      <VBox styleClass="table-wrapper" BorderPane.alignment="CENTER">
         <TableView fx:id="tableBook" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="tableTitles" prefWidth="340.0" text="FAVORITE TITLE" />
               <TableColumn fx:id="tableYear" prefWidth="90.0" text="YEAR" />
               <TableColumn fx:id="tablePublisher" prefWidth="230.0" text="PUBLISHER" />
               <TableColumn fx:id="tablePages" prefWidth="95.0" text="PAGES" />
               <TableColumn fx:id="tableISBN" prefWidth="150.0" text="ISBN" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </center>

   <!-- BOTTOM BAR -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="footer-bar" BorderPane.alignment="CENTER">
         <Label styleClass="footer-hint" text="💡 Double-click any favorite book to open its dossier, or select a row to remove it from favorites." />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="buttonRemoveFavorite" mnemonicParsing="false" styleClass="btn-secondary" text="✕ Remove Selected" />
         <Button fx:id="buttonDetails" mnemonicParsing="false" styleClass="btn-primary" text="Inspect Book →" />
      </HBox>
   </bottom>

</BorderPane>
