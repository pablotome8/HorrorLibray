<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="940.0"
            styleClass="app-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bibliotecaterror.controller.LibraryController">

   <!-- TOP HEADER & SEARCH BAR -->
   <top>
      <VBox BorderPane.alignment="CENTER">
         <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <VBox spacing="4.0">
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label styleClass="brand-badge" text="STEPHEN KING ARCHIVE" />
                  <Label fx:id="labelFavCount" styleClass="stat-badge-accent" text="★ 0 Favorites" />
               </HBox>
               <Label styleClass="header-title" text="Stephen King's Horror Library" />
               <Label styleClass="header-subtitle" text="Explore the complete literary catalog, filter editions, and curate your personal reading list." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <Button fx:id="buttonFavorites" mnemonicParsing="false" styleClass="btn-secondary" text="★ View Favorites" />
               <Button fx:id="buttonExport" mnemonicParsing="false" styleClass="btn-primary" text="💾 Save Favorites" />
            </HBox>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-pane">
            <TextField fx:id="searchField"
                       promptText="🔍 Search books by title, publication year, publisher, or ISBN..."
                       styleClass="search-field"
                       HBox.hgrow="ALWAYS" />
            <Label fx:id="labelCount" styleClass="stat-badge" text="0 Books" />
         </HBox>
      </VBox>
   </top>

   <!-- CENTER TABLE -->
   <center>
      <VBox styleClass="table-wrapper" BorderPane.alignment="CENTER">
         <TableView fx:id="tableBook" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="tableTitles" prefWidth="340.0" text="BOOK TITLE" />
               <TableColumn fx:id="tableYear" prefWidth="90.0" text="YEAR" />
               <TableColumn fx:id="tablePublisher" prefWidth="240.0" text="PUBLISHER" />
               <TableColumn fx:id="tablePages" prefWidth="95.0" text="PAGES" />
               <TableColumn fx:id="tableFavorites" prefWidth="110.0" text="★ FAVORITE" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </center>

   <!-- BOTTOM STATUS BAR -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="footer-bar" BorderPane.alignment="CENTER">
         <Label styleClass="footer-hint" text="💡 Double-click any row (or select a book and click Inspect) to view ISBN, publisher details, and editorial notes." />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="buttonDetails" mnemonicParsing="false" styleClass="btn-secondary" text="Inspect Selected Book →" />
      </HBox>
   </bottom>

</BorderPane>
