            </Button>
         </children>
      </GridPane>
   </top>
   <bottom>
      <Button fx:id="buttonExport" mnemonicParsing="false" text="Export Favorites" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </Button>
   </bottom>
</BorderPane>
